<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Alpha Memes</li>
        </mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationConditional">
					<success>Always</success>
					<xpath>/Defs/StyleCategoryDef[defName = "AM_Neolithic"]/thingDefStyles</xpath>
					    <match Class="PatchOperationAdd">
							<xpath>/Defs/StyleCategoryDef[defName = "AM_Neolithic"]/thingDefStyles</xpath>
								<value>
									<li>
										<thingDef>N_WaterPit</thingDef>
										<styleDef>N_WaterPitStyle</styleDef>
									</li>
								</value>
						</match>
				</li>
			</operations>
		</match>
    </Operation>

</Patch>